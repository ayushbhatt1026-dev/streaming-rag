# Environment Configuration Template for Streaming Live RAG
# Copy this file to api_key_env.env and populate with your credentials.

# Production LLM: Groq (openai/gpt-oss-20b)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Optional Alternative LLM backends:
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="..."

# Optional Vector DB Endpoint (defaults to local embedded storage at ./qdrant_data/)
# QDRANT_URL="http://localhost:6333"
